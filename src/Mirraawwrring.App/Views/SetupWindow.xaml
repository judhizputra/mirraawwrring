<Window x:Class="Mirraawwrring.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Mirraawwrring.App.Resources"
        xmlns:vm="clr-namespace:Mirraawwrring.App.ViewModels"
        xmlns:setup="clr-namespace:Mirraawwrring.App.ViewModels.Setup"
        xmlns:conv="clr-namespace:Mirraawwrring.App.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=setup:SetupViewModel}"
        Style="{StaticResource Style.Window}"
        Background="{StaticResource Brush.Panel}"
        Title="{loc:Str Setup_Title}"
        Width="640" Height="580" MinWidth="640" MinHeight="560" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibility" />
        <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />

        <!-- Ikon status bulat 28px untuk baris Deteksi -->
        <DataTemplate x:Key="RowIcon" DataType="{x:Type setup:DetectRowViewModel}">
            <Border x:Name="Circle" Width="28" Height="28" CornerRadius="14" Background="{StaticResource Brush.WarningBadge}" VerticalAlignment="Center">
                <Path x:Name="Glyph" Style="{StaticResource Style.Icon}" Width="14" Height="14" Data="{StaticResource Icon.Warning}" Stroke="{StaticResource Brush.WarningIcon}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Ok">
                    <Setter TargetName="Circle" Property="Background" Value="{StaticResource Brush.AccentBadge}" />
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Check}" />
                    <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Pending">
                    <Setter TargetName="Circle" Property="Background" Value="{StaticResource Brush.CardPressed}" />
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Info}" />
                    <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource Brush.TextMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Failed">
                    <Setter TargetName="Circle" Property="Background" Value="{StaticResource Brush.ErrorBackground}" />
                    <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource Brush.ErrorIcon}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Ikon kecil 16px untuk baris Verifikasi -->
        <DataTemplate x:Key="VerifyIcon" DataType="{x:Type setup:VerifyRowViewModel}">
            <Grid Width="16" Height="16" VerticalAlignment="Center">
                <Path x:Name="Glyph" Style="{StaticResource Style.Icon}" Width="16" Height="16" Data="{StaticResource Icon.Check}" Stroke="{StaticResource Brush.Accent}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Pending">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Refresh}" />
                    <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource Brush.TextMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Skipped">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Info}" />
                    <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource Brush.TextMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Warning}" />
                    <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource Brush.WarningIcon}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Failed">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Warning}" />
                    <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource Brush.ErrorIcon}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Baris verifikasi: normal (baris) atau gagal (kartu error dengan tombol perbaikan) -->
        <DataTemplate x:Key="VerifyRow" DataType="{x:Type setup:VerifyRowViewModel}">
            <Grid>
                <Grid Margin="14,6" Visibility="{Binding IsOkRow, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource VerifyIcon}" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Style.Text.Muted}" VerticalAlignment="Center" MaxWidth="300" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" />
                    <Button Grid.Column="3" Style="{StaticResource Style.Button.Subtle}" Height="24" Padding="6,0" Margin="6,0,0,0" Content="{Binding FixText}"
                            Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding DataContext.Verify.FixCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </Grid>
                <Border Margin="8,4,8,8" Padding="10" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.ErrorBackground}"
                        BorderBrush="{StaticResource Brush.ErrorBorder}" BorderThickness="1" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Style="{StaticResource Style.Icon}" Width="16" Height="16" Data="{StaticResource Icon.Warning}" Stroke="{StaticResource Brush.ErrorIcon}" Margin="0,2,10,0" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding FailedTitle}" FontWeight="SemiBold" Foreground="{StaticResource Brush.ErrorText}" />
                            <TextBlock Text="{Binding FailedDescription}" Style="{StaticResource Style.Text.Muted}" Foreground="{StaticResource Brush.ErrorBody}" Margin="0,3,0,0"
                                       Visibility="{Binding FailedDescription, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Style.Text.Mono}" Foreground="{StaticResource Brush.ErrorBody}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Style.Button.Danger}" Content="{Binding FixText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding DataContext.Verify.FixCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Tiny}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="Margin" Value="14,8,14,4" />
            <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
        </Style>

        <Style x:Key="LogBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Log}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <DataTemplate x:Key="LogLine" DataType="{x:Type vm:LogLineItem}">
            <TextBlock x:Name="Line" Text="{Binding Text}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource FontSize.Log}" Foreground="{StaticResource Brush.TextMuted}" LineHeight="18" TextTrimming="CharacterEllipsis" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                    <Setter TargetName="Line" Property="Foreground" Value="{StaticResource Brush.ErrorText}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Halaman 1: Deteksi ===== -->
        <DataTemplate DataType="{x:Type setup:DetectPageViewModel}">
            <StackPanel>
                <TextBlock Style="{StaticResource Style.Text.Title}" Text="{loc:Str Detect_Heading}" />
                <TextBlock Style="{StaticResource Style.Text.Muted}" FontSize="{StaticResource FontSize.Body}" Text="{loc:Str Detect_Intro}" Margin="0,6,0,14" />
                <Border Style="{StaticResource Style.Card}" Padding="0">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type setup:DetectRowViewModel}">
                                <Border BorderBrush="{StaticResource Brush.CardPressed}" BorderThickness="0,0,0,1" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowIcon}" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSize.Emphasis}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Style.Text.Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="400" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold" Foreground="{StaticResource Brush.WarningText}" HorizontalAlignment="Right" />
                                            <TextBlock FontSize="{StaticResource FontSize.Tiny}" HorizontalAlignment="Right" Visibility="{Binding ShowHowTo, Converter={StaticResource BoolToVisibility}}">
                                                <Hyperlink Style="{StaticResource Style.Hyperlink}" Command="{Binding DataContext.ShowPhoneGuideCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <Run Text="{loc:Str Detect_HowTo}" />
                                                </Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Ok">
                                        <Setter TargetName="Status" Property="Foreground" Value="{StaticResource Brush.AccentText}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Pending">
                                        <Setter TargetName="Status" Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="{StaticResource Radius.Card}" Background="{StaticResource Brush.AccentSoft}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Style.Icon}" Data="{StaticResource Icon.Info}" Stroke="{StaticResource Brush.Accent}" Margin="0,0,10,0" VerticalAlignment="Top" />
                        <TextBlock Style="{StaticResource Style.Text.Secondary}" Text="{loc:Str Detect_Hint}" MaxWidth="520" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- ===== Halaman 2: Pasang ===== -->
        <DataTemplate DataType="{x:Type setup:InstallPageViewModel}">
            <StackPanel>
                <TextBlock Style="{StaticResource Style.Text.Title}" Text="{loc:Str Install_Heading}" Margin="0,0,0,12" />

                <RadioButton Style="{StaticResource Style.OptionCard}" GroupName="Install" IsChecked="{Binding IsDownloadSelected}" IsEnabled="{Binding IsInstalling, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}" AutomationProperties.Name="{loc:Str Install_Auto}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Str Install_Auto}" FontSize="{StaticResource FontSize.Emphasis}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Style.Badge}" Background="{StaticResource Brush.AccentBadge}" Margin="8,0,0,0" Padding="8,2">
                                <TextBlock Text="{loc:Str Install_Recommended}" Style="{StaticResource Style.BadgeText}" Foreground="{StaticResource Brush.AccentText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding AutoDescription}" Style="{StaticResource Style.Text.Muted}" Margin="0,6,0,0" />
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{Binding ProgressTitle}" Style="{StaticResource Style.Text.Secondary}" />
                                <TextBlock Text="{Binding ProgressBytes}" Style="{StaticResource Style.Text.Secondary}" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Style="{StaticResource Style.ProgressBar}" Value="{Binding Percent, Mode=OneWay}" />
                            <TextBlock Text="{loc:Str Install_AfterDownload}" FontSize="{StaticResource FontSize.Tiny}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource Style.OptionCard}" GroupName="Install" IsChecked="{Binding IsWingetSelected}" AutomationProperties.Name="{loc:Str Install_Winget}">
                    <StackPanel>
                        <TextBlock Text="{loc:Str Install_Winget}" FontSize="{StaticResource FontSize.Emphasis}" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Str Install_WingetDesc}" Style="{StaticResource Style.Text.Muted}" Margin="0,6,0,6" />
                        <Border Background="{StaticResource Brush.WindowBackground}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding WingetCommand}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.TextSecondary}" />
                        </Border>
                        <Border Style="{StaticResource LogBox}" Margin="0,8,0,0" MaxHeight="110" Visibility="{Binding HasWingetOutput, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding WingetOutput}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource FontSize.Log}" Foreground="{StaticResource Brush.TextMuted}" LineHeight="18" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource Style.OptionCard}" GroupName="Install" IsChecked="{Binding IsFolderSelected}" AutomationProperties.Name="{loc:Str Install_Existing}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Str Install_Existing}" FontSize="{StaticResource FontSize.Emphasis}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Str Install_ExistingDesc}" Style="{StaticResource Style.Text.Muted}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding FolderMessage}" Style="{StaticResource Style.Text.Mono}" Margin="0,4,0,0" Visibility="{Binding FolderMessage, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Style.Button}" Height="32" Padding="12,0" FontSize="{StaticResource FontSize.Small}" Content="{loc:Str Install_PickFolder}" VerticalAlignment="Center" Margin="12,0,0,0" Click="OnPickFolder" />
                    </Grid>
                </RadioButton>

                <Border Padding="12,10" CornerRadius="{StaticResource Radius.Card}" Background="{StaticResource Brush.ErrorBackground}" BorderBrush="{StaticResource Brush.ErrorBorder}" BorderThickness="1"
                        Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding Error}" Style="{StaticResource Style.Text.Secondary}" Foreground="{StaticResource Brush.ErrorText}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- ===== Halaman 3: Verifikasi ===== -->
        <DataTemplate DataType="{x:Type setup:VerifyPageViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock x:Name="Heading" Style="{StaticResource Style.Text.Title}" Text="{loc:Str Verify_Heading}" />
                    <TextBlock x:Name="FailedIntro" Style="{StaticResource Style.Text.Muted}" Text="{loc:Str Verify_FailedIntro}" Margin="0,4,0,0" Visibility="Collapsed" />
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Style.Card}" Padding="0,2,0,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GroupLabel}" Text="{loc:Str Verify_GroupScrcpy}" />
                        <ItemsControl ItemsSource="{Binding ScrcpyRows}" ItemTemplate="{StaticResource VerifyRow}" />
                        <Border Height="1" Background="{StaticResource Brush.CardPressed}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource GroupLabel}" Text="{loc:Str Verify_GroupAdb}" />
                        <ItemsControl ItemsSource="{Binding AdbRows}" ItemTemplate="{StaticResource VerifyRow}" />
                        <Border Height="1" Background="{StaticResource Brush.CardPressed}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource GroupLabel}" Text="{loc:Str Verify_GroupPhone}" />
                        <ItemsControl ItemsSource="{Binding PhoneRows}" ItemTemplate="{StaticResource VerifyRow}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource LogBox}" Margin="0,10,0,0" MinHeight="60">
                    <ItemsControl x:Name="VerifyLog" ItemsSource="{Binding LogLines}" ItemTemplate="{StaticResource LogLine}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                    </ItemsControl>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasRun}" Value="True" />
                        <Condition Binding="{Binding IsRunning}" Value="False" />
                    </MultiDataTrigger.Conditions>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding FailedCount}" Value="0" />
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Halaman 3c: HP ===== -->
        <DataTemplate DataType="{x:Type setup:PhonePageViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource Style.Text.Title}" Text="{loc:Str Phone_Heading}" />
                    <TextBlock Style="{StaticResource Style.Text.Muted}" Text="{Binding Intro}" Margin="0,4,0,0" />
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="210" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Style.Card}" Padding="14,12">
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type setup:NumberedStep}">
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Style.Text.Secondary}" FontSize="12.5" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Style.Text.Secondary}" FontSize="12.5" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Style.Card}" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource GroupLabel}" Margin="0,0,0,6" Text="{loc:Str Phone_StatusTitle}" />
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type setup:DetectRowViewModel}">
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="Glyph" Style="{StaticResource Style.Icon}" Width="16" Height="16" Data="{StaticResource Icon.Info}" Stroke="{StaticResource Brush.TextMuted}" Margin="0,1,8,0" VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="Title" Text="{Binding Title}" />
                                                <TextBlock x:Name="Desc" Text="{Binding Description}" FontSize="{StaticResource FontSize.Tiny}" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Ok">
                                                <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Check}" />
                                                <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource Brush.Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Warning}" />
                                                <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource Brush.WarningIcon}" />
                                                <Setter TargetName="Desc" Property="Foreground" Value="{StaticResource Brush.WarningText}" />
                                                <Setter TargetName="Desc" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Pending">
                                                <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Grid.Row="2" BorderBrush="{StaticResource Brush.CardPressed}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Style.Icon}" Width="12" Height="12" Data="{StaticResource Icon.Refresh}" Stroke="{StaticResource Brush.TextMuted}" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Str Phone_AutoRefresh}" FontSize="{StaticResource FontSize.Tiny}" Foreground="{StaticResource Brush.TextMuted}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ===== Halaman 4: Selesai ===== -->
        <DataTemplate DataType="{x:Type setup:DonePageViewModel}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                    <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource Brush.AccentBadge}" Margin="0,0,14,0">
                        <Path Style="{StaticResource Style.Icon}" Width="22" Height="22" Data="{StaticResource Icon.Check}" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2.5" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Style.Text.Title}" Text="{loc:Str Done_Heading}" />
                        <TextBlock Style="{StaticResource Style.Text.Muted}" Text="{Binding Subtitle}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Background="{StaticResource Brush.Border}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Background="{StaticResource Brush.Card}" Margin="0" >
                            <StackPanel Margin="14,10">
                                <TextBlock Text="{loc:Str Done_Scrcpy}" FontSize="{StaticResource FontSize.Tiny}" Foreground="{StaticResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding ScrcpyVersion}" FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Background="{StaticResource Brush.Card}">
                            <StackPanel Margin="14,10">
                                <TextBlock Text="{loc:Str Done_Adb}" FontSize="{StaticResource FontSize.Tiny}" Foreground="{StaticResource Brush.TextMuted}" />
                                <TextBlock Text="{loc:Str Done_AdbValue}" FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Background="{StaticResource Brush.Card}">
                            <StackPanel Margin="14,10">
                                <TextBlock Text="{loc:Str Done_Location}" FontSize="{StaticResource FontSize.Tiny}" Foreground="{StaticResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding Location}" Style="{StaticResource Style.Text.Mono}" Foreground="{StaticResource Brush.Text}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Style="{StaticResource Style.Text.Secondary}" FontWeight="SemiBold" Text="{loc:Str Done_NextTitle}" Margin="0,16,0,8" />
                <UniformGrid Columns="2" Margin="-5,0">
                    <Button Style="{StaticResource Style.ChoiceCard}" Margin="5,0" Command="{Binding DataContext.OpenUsbCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{loc:Str Done_Usb}">
                        <StackPanel>
                            <Path Style="{StaticResource Style.Icon}" Data="{StaticResource Icon.Usb}" Stroke="{StaticResource Brush.Accent}" HorizontalAlignment="Left" Margin="0,0,0,6" />
                            <TextBlock Text="{loc:Str Done_Usb}" FontSize="{StaticResource FontSize.Emphasis}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Str Done_UsbDesc}" Style="{StaticResource Style.Text.Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Style.ChoiceCard}" Margin="5,0" Command="{Binding DataContext.OpenWirelessCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{loc:Str Done_Wireless}">
                        <StackPanel>
                            <Path Style="{StaticResource Style.Icon}" Data="{StaticResource Icon.Wifi}" Stroke="{StaticResource Brush.Accent}" HorizontalAlignment="Left" Margin="0,0,0,6" />
                            <TextBlock Text="{loc:Str Done_Wireless}" FontSize="{StaticResource FontSize.Emphasis}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Str Done_WirelessDesc}" Style="{StaticResource Style.Text.Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
                <CheckBox Style="{StaticResource Style.CheckBox}" Content="{loc:Str Done_CheckUpdates}" IsChecked="{Binding CheckUpdates}" Margin="0,14,0,0" Foreground="{StaticResource Brush.TextSecondary}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- Stepper: 4 langkah dengan garis penghubung fleksibel -->
        <Grid Margin="24,18,24,14">
            <Grid.Resources>
                <DataTemplate x:Key="StepItem" DataType="{x:Type setup:StepIndicatorViewModel}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Circle" Width="22" Height="22" CornerRadius="11" BorderBrush="{StaticResource Brush.BorderControl}" BorderThickness="1" Background="Transparent">
                            <Grid>
                                <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="{StaticResource FontSize.Tiny}" FontWeight="Bold" Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path x:Name="Check" Style="{StaticResource Style.Icon}" Width="12" Height="12" Data="{StaticResource Icon.Check}" Stroke="{StaticResource Brush.OnAccent}" StrokeThickness="2.5" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                            <Setter TargetName="Circle" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Circle" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Num" Property="Foreground" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Brush.Text}" />
                            <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                            <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource Brush.ErrorIcon}" />
                            <Setter TargetName="Num" Property="Foreground" Value="{StaticResource Brush.ErrorIcon}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
                <Style x:Key="StepLine" TargetType="Border">
                    <Setter Property="Height" Value="2" />
                    <Setter Property="Margin" Value="10,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Background" Value="{StaticResource Brush.BorderStrong}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl Grid.Column="0" Content="{Binding Steps[0]}" ContentTemplate="{StaticResource StepItem}" />
            <Border Grid.Column="1" Style="{StaticResource StepLine}" DataContext="{Binding Steps[0]}" />
            <ContentControl Grid.Column="2" Content="{Binding Steps[1]}" ContentTemplate="{StaticResource StepItem}" />
            <Border Grid.Column="3" Style="{StaticResource StepLine}" DataContext="{Binding Steps[1]}" />
            <ContentControl Grid.Column="4" Content="{Binding Steps[2]}" ContentTemplate="{StaticResource StepItem}" />
            <Border Grid.Column="5" Style="{StaticResource StepLine}" DataContext="{Binding Steps[2]}" />
            <ContentControl Grid.Column="6" Content="{Binding Steps[3]}" ContentTemplate="{StaticResource StepItem}" />
        </Grid>

        <!-- Konten -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,4,24,14">
            <ContentControl Content="{Binding CurrentPage}" />
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid>
                <Button Style="{StaticResource Style.Button}" Height="40" HorizontalAlignment="Left" Content="{Binding LeftText}" Command="{Binding LeftCommand}"
                        Visibility="{Binding LeftVisible, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Style.Button}" Height="40" Content="{Binding SecondaryText}" Command="{Binding SecondaryCommand}" Margin="0,0,10,0"
                            Visibility="{Binding SecondaryVisible, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Style.Button.Accent}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" IsEnabled="{Binding PrimaryEnabled}" Padding="20,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
