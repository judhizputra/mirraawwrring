<Window x:Class="Mirraawwrring.App.Views.PairWirelessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Mirraawwrring.App.Resources"
        xmlns:vm="clr-namespace:Mirraawwrring.App.ViewModels"
        xmlns:conv="clr-namespace:Mirraawwrring.App.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PairWirelessViewModel}"
        Style="{StaticResource Style.Window}"
        Background="{StaticResource Brush.Panel}"
        Title="{loc:Str Pair_Title}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <Style x:Key="Digit" TargetType="TextBox" BasedOn="{StaticResource Style.TextBox}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="48" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MaxLength" Value="6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="InputMethod.IsInputMethodEnabled" Value="False" />
        </Style>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource Brush.CardPressed}" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <TextBlock Style="{StaticResource Style.Text.Title}" Text="{loc:Str Pair_Heading}" />
        <TextBlock Style="{StaticResource Style.Text.Muted}" Text="{loc:Str Pair_Subtitle}" Margin="0,6,0,18" />

        <!-- Langkah di HP -->
        <Border Style="{StaticResource Style.Card}" Padding="14,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Style.Text.Secondary}" FontSize="{StaticResource FontSize.Body}" Margin="0,0,0,6"><Run Text="1." />  <Run Text="{loc:Str Pair_Step1}" /></TextBlock>
                <TextBlock Style="{StaticResource Style.Text.Secondary}" FontSize="{StaticResource FontSize.Body}" Margin="0,0,0,6"><Run Text="2." />  <Run Text="{loc:Str Pair_Step2}" /></TextBlock>
                <TextBlock Style="{StaticResource Style.Text.Secondary}" FontSize="{StaticResource FontSize.Body}"><Run Text="3." />  <Run Text="{loc:Str Pair_Step3}" /></TextBlock>
            </StackPanel>
        </Border>

        <!-- Langkah 1: Pairing -->
        <StackPanel Margin="0,18,0,0" IsEnabled="{Binding IsStep1Enabled}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Style="{StaticResource StepNumber}" Background="{StaticResource Brush.Accent}">
                    <TextBlock Text="1" FontSize="{StaticResource FontSize.Tiny}" FontWeight="Bold" Foreground="{StaticResource Brush.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{loc:Str Pair_Section1}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource Style.Text.Muted}" Text="{loc:Str Pair_AddressLabel}" Margin="0,0,0,6" />
            <TextBox x:Name="AddressBox" Style="{StaticResource Style.TextBox}" Tag="{loc:Str Pair_AddressPlaceholder}"
                     Text="{Binding PairingAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Str Pair_AddressLabel}" />
            <TextBlock Style="{StaticResource Style.Text.Muted}" Text="{loc:Str Pair_CodeLabel}" Margin="0,12,0,6" />
            <StackPanel x:Name="DigitPanel" Orientation="Horizontal">
                <TextBox Style="{StaticResource Digit}" AutomationProperties.Name="Digit 1" />
                <TextBox Style="{StaticResource Digit}" AutomationProperties.Name="Digit 2" />
                <TextBox Style="{StaticResource Digit}" AutomationProperties.Name="Digit 3" />
                <TextBox Style="{StaticResource Digit}" AutomationProperties.Name="Digit 4" />
                <TextBox Style="{StaticResource Digit}" AutomationProperties.Name="Digit 5" />
                <TextBox Style="{StaticResource Digit}" Margin="0" AutomationProperties.Name="Digit 6" />
            </StackPanel>
        </StackPanel>

        <!-- Langkah 2: Sambung -->
        <StackPanel Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StepNumber}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NeedsConnectPort}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="2" FontSize="{StaticResource FontSize.Tiny}" FontWeight="Bold" Foreground="{StaticResource Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{loc:Str Pair_Section2}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Style.Text.Muted}" Text="{loc:Str Pair_Section2Hint}" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource Style.Text.Muted}" Text="{loc:Str Pair_PortLabel}" Margin="0,0,0,6" />
            <TextBox x:Name="PortBox" Style="{StaticResource Style.TextBox}" Tag="{loc:Str Pair_PortPlaceholder}" IsEnabled="{Binding NeedsConnectPort}"
                     Text="{Binding ConnectPort, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Str Pair_PortLabel}" />
        </StackPanel>

        <!-- Status -->
        <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="{StaticResource Radius.Card}" BorderThickness="1"
                Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.ErrorBackground}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.ErrorBorder}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Secondary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.ErrorText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Footer -->
        <Grid Margin="0,18,0,0">
            <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.TextDisabled}"
                       Text="{loc:Str Pair_Qr}" ToolTip="{loc:Str Main_NotYet}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Style.Button}" Height="40" Content="{loc:Str Pair_Cancel}" IsCancel="True" Margin="0,0,10,0" />
                <Button Style="{StaticResource Style.Button.Accent}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" IsDefault="True" Padding="20,0" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
