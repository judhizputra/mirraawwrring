<UserControl x:Class="Mirraawwrring.App.Views.FilesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:Mirraawwrring.App.Resources"
             xmlns:conv="clr-namespace:Mirraawwrring.App.Converters"
             xmlns:vm="clr-namespace:Mirraawwrring.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FilesPanelViewModel}"
             FontFamily="{StaticResource Font.UI}"
             FontSize="{StaticResource FontSize.Body}"
             Foreground="{StaticResource Brush.Text}"
             AllowDrop="True"
             AutomationProperties.Name="{loc:Str Files_Title}">

    <!-- Panel file browser (mockup Running-Files): header, pintasan, breadcrumb, aksi, daftar, area drop, status transfer. -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibility" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:EnumToBoolConverter x:Key="EnumToBool" />

        <Style x:Key="Style.Icon.Kind" TargetType="Path" BasedOn="{StaticResource Style.Icon}">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Data" Value="{StaticResource Icon.File}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Folder">
                    <Setter Property="Data" Value="{StaticResource Icon.Folder}" />
                    <Setter Property="Stroke" Value="{StaticResource Brush.AccentText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Image">
                    <Setter Property="Data" Value="{StaticResource Icon.Image}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Video">
                    <Setter Property="Data" Value="{StaticResource Icon.Video}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="PanelRoot"
            Background="{StaticResource Brush.Panel}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Panel}"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,0,8,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Style.Text.Heading}" Text="{loc:Str Files_Title}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Style.Text.Muted}" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding DeviceName}" />
                    </StackPanel>
                    <Button Style="{StaticResource Style.Button.Subtle}" Width="34" Height="34" Padding="0" HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                            Command="{Binding CloseCommand}" AutomationProperties.Name="{loc:Str Files_Close}" ToolTip="{loc:Str Files_Close}">
                        <Path Style="{StaticResource Style.Icon}" Width="16" Height="16" Data="{StaticResource Icon.Close}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Pintasan -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Shortcuts}" Margin="16,12,10,2">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ShortcutViewModel}">
                        <Button Style="{StaticResource Style.Chip}" Content="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Path}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Breadcrumb -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Breadcrumb}" Margin="12,0,16,8" AutomationProperties.Name="Lokasi">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CrumbViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Style.Button.Crumb}" Content="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Path}"
                                    Visibility="{Binding IsLast, Converter={StaticResource InvertedBoolToVisibility}}" />
                            <TextBlock Style="{StaticResource Style.Text}" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center" Text="{Binding Name}"
                                       Visibility="{Binding IsLast, Converter={StaticResource BoolToVis}}" />
                            <Path Style="{StaticResource Style.Icon}" Width="12" Height="12" Margin="2,0" Stroke="{StaticResource Brush.TextMuted}" Data="{StaticResource Icon.ChevronRight}"
                                  Visibility="{Binding IsLast, Converter={StaticResource InvertedBoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Aksi -->
            <Grid Grid.Row="3" Margin="16,0,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource Style.Button.Accent.Small}" Command="{Binding PullCommand}" AutomationProperties.Name="{loc:Str Files_Pull}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Style.Icon}" Width="14" Height="14" Margin="0,0,6,0" Stroke="{StaticResource Brush.OnAccent}" Data="{StaticResource Icon.Download}" />
                        <TextBlock Text="{Binding PullText}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource Style.Button.Small}" Margin="8,0,0,0" Command="{Binding PushCommand}" AutomationProperties.Name="{loc:Str Files_Push}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Style.Icon}" Width="14" Height="14" Margin="0,0,6,0" Data="{StaticResource Icon.Upload}" />
                        <TextBlock Text="{loc:Str Files_Push}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource Style.Button.Small.Icon}" Margin="8,0,0,0" Command="{Binding BeginNewFolderCommand}" AutomationProperties.Name="{loc:Str Files_NewFolder}" ToolTip="{loc:Str Files_NewFolder}">
                    <Path Style="{StaticResource Style.Icon}" Width="16" Height="16" Data="{StaticResource Icon.FolderPlus}" />
                </Button>
                <Button Grid.Column="3" Style="{StaticResource Style.Button.Small.Icon}" Margin="8,0,0,0" Command="{Binding BeginRenameCommand}" AutomationProperties.Name="{loc:Str Files_Rename}" ToolTip="{loc:Str Files_Rename}">
                    <Path Style="{StaticResource Style.Icon}" Width="16" Height="16" Data="{StaticResource Icon.Edit}" />
                </Button>
                <Button Grid.Column="4" Style="{StaticResource Style.Button.Small.Icon}" Margin="8,0,0,0" Command="{Binding DeleteCommand}" AutomationProperties.Name="{loc:Str Files_Delete}" ToolTip="{loc:Str Files_Delete}">
                    <Path Style="{StaticResource Style.Icon}" Width="16" Height="16" Data="{StaticResource Icon.Trash}" />
                </Button>
                <Grid Grid.Column="5" Margin="8,0,0,0" MinWidth="120">
                    <TextBox Style="{StaticResource Style.TextBox}" Height="32" Padding="30,0,8,0" Tag="{loc:Str Files_Search}" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Str Files_Search}" />
                    <Path Style="{StaticResource Style.Icon}" Width="14" Height="14" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Stroke="{StaticResource Brush.TextMuted}" Data="{StaticResource Icon.Search}" />
                </Grid>
            </Grid>

            <!-- Editor nama: folder baru / ganti nama -->
            <Border Grid.Row="4" Margin="16,0,16,10" Padding="10,8" Style="{StaticResource Style.Card}" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EditorBox" Style="{StaticResource Style.TextBox}" Height="32" Tag="{Binding EditorPrompt}" Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding EditorPrompt}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CommitEditorCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding CancelEditorCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Style="{StaticResource Style.Button.Accent.Small}" Margin="8,0,0,0" Content="{loc:Str Files_Ok}" Command="{Binding CommitEditorCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource Style.Button.Small}" Margin="8,0,0,0" Content="{loc:Str Files_Cancel}" Command="{Binding CancelEditorCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Style.Text.Muted}" Foreground="{StaticResource Brush.ErrorText}" Margin="0,6,0,0" Text="{Binding EditorError}" Visibility="{Binding EditorError, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </Border>

            <!-- Header kolom -->
            <Border Grid.Row="5" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Style="{StaticResource Style.Text.ColumnHeader}" Text="{loc:Str Files_ColName}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Style.Text.ColumnHeader}" TextAlignment="Right" Text="{loc:Str Files_ColSize}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Style.Text.ColumnHeader}" Margin="8,0,0,0" Text="{loc:Str Files_ColModified}" />
                </Grid>
            </Border>

            <!-- Daftar -->
            <Grid Grid.Row="6">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Style="{StaticResource Style.Button.Subtle}" Height="40" Padding="16,0" HorizontalContentAlignment="Left" FontSize="{StaticResource FontSize.Body}"
                            Command="{Binding UpCommand}" Visibility="{Binding HasParent, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="{Binding UpText}">
                        <StackPanel Orientation="Horizontal" Margin="28,0,0,0">
                            <Path Style="{StaticResource Style.Icon}" Width="16" Height="16" Margin="0,0,10,0" Data="{StaticResource Icon.Folder}" />
                            <TextBlock Text="{Binding UpText}" />
                        </StackPanel>
                    </Button>
                    <ListBox x:Name="FileList" Style="{StaticResource Style.FileList}" ItemContainerStyle="{StaticResource Style.FileRow}" ItemsSource="{Binding VisibleEntries}"
                             MouseDoubleClick="OnListDoubleClick" AutomationProperties.Name="Daftar file">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RemoteEntryViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource Style.CheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Path Style="{StaticResource Style.Icon.Kind}" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource Style.Text}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Text="{Binding Name}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Style.Text.Muted}" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding SizeText}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource Style.Text.Muted}" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding ModifiedText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <TextBlock Style="{StaticResource Style.Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" TextAlignment="Center" Text="{Binding EmptyText}"
                           Visibility="{Binding EmptyText, Converter={StaticResource NullToCollapsed}}" />
            </Grid>

            <!-- Area drop -->
            <Grid Grid.Row="7" Margin="16,10" x:Name="DropZone">
                <Rectangle x:Name="DropOutline" Stroke="{StaticResource Brush.BorderControl}" StrokeThickness="1.5" StrokeDashArray="4 2" RadiusX="8" RadiusY="8" />
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Style="{StaticResource Style.Icon}" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center" Stroke="{StaticResource Brush.TextMuted}" Data="{StaticResource Icon.Upload}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Style.Text.Muted}" LineHeight="17" VerticalAlignment="Center" Text="{loc:Str Files_DropHint}" />
                </Grid>
            </Grid>

            <!-- Status transfer / tujuan -->
            <Border Grid.Row="8" Background="{StaticResource Brush.StatusBar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,10" CornerRadius="0,0,9,9">
                <StackPanel>
                    <StackPanel Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock Style="{StaticResource Style.Text.Secondary}" Text="{Binding TransferTitle}" />
                            <TextBlock Style="{StaticResource Style.Text.Secondary}" HorizontalAlignment="Right" Text="{Binding TransferPercentText}" />
                        </Grid>
                        <ProgressBar Style="{StaticResource Style.ProgressBar}" Height="5" Margin="0,6,0,0" Minimum="0" Maximum="1" Value="{Binding TransferFraction, Mode=OneWay}" IsIndeterminate="{Binding TransferIndeterminate}" />
                        <Grid Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource Style.Text.Muted}" FontSize="{StaticResource FontSize.Tiny}" Text="{Binding TransferDetail}" TextTrimming="CharacterEllipsis" Margin="0,0,80,0" />
                            <Button Style="{StaticResource Style.Button.Subtle}" Height="22" HorizontalAlignment="Right" Content="{loc:Str Files_CancelTransfer}" Command="{Binding CancelTransferCommand}" FontSize="{StaticResource FontSize.Tiny}" />
                        </Grid>
                    </StackPanel>
                    <Grid Visibility="{Binding IsTransferring, Converter={StaticResource InvertedBoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Style.Text.Muted}" VerticalAlignment="Center" Text="{Binding PullDirectoryText}" TextTrimming="CharacterEllipsis" />
                            <Button Style="{StaticResource Style.Button.Subtle}" Height="22" Margin="4,0,0,0" FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.Link}" Content="{loc:Str Files_ChangePullDir}" Command="{Binding ChangePullDirectoryCommand}" AutomationProperties.Name="{loc:Str Files_PickPullDir}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Style.Text.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Brush.WarningText}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
