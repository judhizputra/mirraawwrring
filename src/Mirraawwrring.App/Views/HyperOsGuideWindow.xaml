<Window x:Class="Mirraawwrring.App.Views.HyperOsGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Mirraawwrring.App.Resources"
        Style="{StaticResource Style.Window}"
        Background="{StaticResource Brush.Panel}"
        Title="{loc:Str Guide_Title}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Style="{StaticResource Style.Text.Title}" Text="{loc:Str Guide_Heading}" />
        <TextBlock Style="{StaticResource Style.Text.Muted}" Text="{loc:Str Guide_Intro}" Margin="0,6,0,14" />

        <Border Style="{StaticResource Style.Card}" Padding="16,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Style.Text.Secondary}" FontSize="{StaticResource FontSize.Body}" Margin="0,0,0,8"><Run Text="1." FontWeight="SemiBold" />  <Run Text="{loc:Str Guide_Step1}" /></TextBlock>
                <TextBlock Style="{StaticResource Style.Text.Secondary}" FontSize="{StaticResource FontSize.Body}" Margin="0,0,0,8"><Run Text="2." FontWeight="SemiBold" />  <Run Text="{loc:Str Guide_Step2}" /></TextBlock>
                <TextBlock Style="{StaticResource Style.Text.Secondary}" FontSize="{StaticResource FontSize.Body}" Margin="0,0,0,8"><Run Text="3." FontWeight="SemiBold" />  <Run Text="{loc:Str Guide_Step3}" /></TextBlock>
                <TextBlock Style="{StaticResource Style.Text.Secondary}" FontSize="{StaticResource FontSize.Body}" Margin="0,0,0,8"><Run Text="4." FontWeight="SemiBold" />  <Run Text="{loc:Str Guide_Step4}" /></TextBlock>
                <TextBlock Style="{StaticResource Style.Text.Secondary}" FontSize="{StaticResource FontSize.Body}"><Run Text="5." FontWeight="SemiBold" />  <Run Text="{loc:Str Guide_Step5}" /></TextBlock>
            </StackPanel>
        </Border>

        <Border Margin="0,12,0,0" Padding="12" CornerRadius="{StaticResource Radius.Card}"
                Background="{StaticResource Brush.AccentSoft}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource Style.Icon}" Data="{StaticResource Icon.Info}" Stroke="{StaticResource Brush.Accent}" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock Style="{StaticResource Style.Text.Secondary}" Text="{loc:Str Guide_UhidHint}" MaxWidth="460" />
            </StackPanel>
        </Border>

        <Button Style="{StaticResource Style.Button.Accent}" Content="{loc:Str Guide_Close}" HorizontalAlignment="Right" Margin="0,18,0,0" IsCancel="True" IsDefault="True" />
    </StackPanel>
</Window>
