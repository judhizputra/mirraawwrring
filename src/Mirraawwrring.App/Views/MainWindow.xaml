<Window x:Class="Mirraawwrring.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Mirraawwrring.App.Resources"
        xmlns:vm="clr-namespace:Mirraawwrring.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Style="{StaticResource Style.Window}"
        Title="{loc:Str Main_Title}"
        Width="1000" Height="700" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16,14,16,12">
        <Border Style="{StaticResource Style.Panel}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                <TextBlock Style="{StaticResource Style.Text.Title}" Text="{loc:Str App_Name}" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Style.Text.Muted}" Text="{loc:Str Main_FoundationPlaceholder}" Margin="0,8,0,0" TextAlignment="Center" />
                <TextBlock Style="{StaticResource Style.Text.Mono}" Text="{Binding DataLocation}" Margin="0,16,0,0" TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
