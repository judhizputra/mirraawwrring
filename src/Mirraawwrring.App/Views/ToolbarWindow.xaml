<Window x:Class="Mirraawwrring.App.Views.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Mirraawwrring.App.Resources"
        xmlns:conv="clr-namespace:Mirraawwrring.App.Converters"
        xmlns:vm="clr-namespace:Mirraawwrring.App.ViewModels"
        xmlns:views="clr-namespace:Mirraawwrring.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ToolbarViewModel}"
        Title="{loc:Str Toolbar_Title}"
        Style="{StaticResource Style.Window}"
        Background="{x:Null}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        ShowActivated="False"
        SizeToContent="Manual"
        Width="256"
        Height="640">

    <!--
        Toolbar samping (mockup Running-Toolbar). Jendela transparan: kolom kiri = toolbar 52 px, kolom kanan = legenda (atas) dan toast (bawah).
        Area transparan tidak menangkap klik (layered window). Posisi diatur ToolbarWindow.xaml.cs mengikuti jendela scrcpy.
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibility" />

        <!-- Isi tooltip: nama + badge pintasan -->
        <DataTemplate x:Key="TipTemplate" DataType="{x:Type vm:ToolbarTip}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Text}" MaxWidth="220" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Border Style="{StaticResource Style.TooltipKey}" Visibility="{Binding Shortcut, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding Shortcut}" FontSize="{StaticResource FontSize.Tiny}" FontWeight="Medium" Foreground="{StaticResource Brush.TooltipKeyText}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="Style.Button.Toolbar.Files" TargetType="Button" BasedOn="{StaticResource Style.Button.Toolbar}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFilesOpen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.AccentBadge}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Style.Icon.Record" TargetType="Path" BasedOn="{StaticResource Style.Icon.Toolbar}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource Brush.ErrorIcon}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Style.Icon.RecordDot" TargetType="Path">
            <Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="19" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Data" Value="{StaticResource Icon.RecordDot}" />
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="Margin" Value="7.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource Brush.ErrorIcon}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FirstColumn" Width="52" />
            <ColumnDefinition x:Name="SecondColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Toolbar -->
        <Border x:Name="ToolbarPanel"
                Grid.Column="0"
                VerticalAlignment="Top"
                Width="52"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Panel}"
                Padding="5">
            <StackPanel>
                <Button Style="{StaticResource Style.Button.Toolbar}" Command="{Binding PowerCommand}" AutomationProperties.Name="{loc:Str Toolbar_Power}">
                    <Button.ToolTip><ToolTip Content="{Binding PowerTip}" ContentTemplate="{StaticResource TipTemplate}" /></Button.ToolTip>
                    <Grid Width="40" Height="40">
                        <Path Style="{StaticResource Style.Icon.Toolbar}" Data="{StaticResource Icon.Power}" />
                        <Ellipse Style="{StaticResource Style.InjectionDot}" Visibility="{Binding InjectionBlocked, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource Style.Button.Toolbar}" Command="{Binding VolumeUpCommand}" AutomationProperties.Name="{loc:Str Toolbar_VolumeUp}">
                    <Button.ToolTip><ToolTip Content="{Binding VolumeUpTip}" ContentTemplate="{StaticResource TipTemplate}" /></Button.ToolTip>
                    <Grid Width="40" Height="40">
                        <Path Style="{StaticResource Style.Icon.Toolbar}" Data="{StaticResource Icon.VolumeUp}" />
                        <Ellipse Style="{StaticResource Style.InjectionDot}" Visibility="{Binding InjectionBlocked, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource Style.Button.Toolbar}" Command="{Binding VolumeDownCommand}" AutomationProperties.Name="{loc:Str Toolbar_VolumeDown}">
                    <Button.ToolTip><ToolTip Content="{Binding VolumeDownTip}" ContentTemplate="{StaticResource TipTemplate}" /></Button.ToolTip>
                    <Grid Width="40" Height="40">
                        <Path Style="{StaticResource Style.Icon.Toolbar}" Data="{StaticResource Icon.VolumeDown}" />
                        <Ellipse Style="{StaticResource Style.InjectionDot}" Visibility="{Binding InjectionBlocked, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource Style.Button.Toolbar}" Command="{Binding RotateCommand}" AutomationProperties.Name="{loc:Str Toolbar_Rotate}">
                    <Button.ToolTip><ToolTip Content="{Binding RotateTip}" ContentTemplate="{StaticResource TipTemplate}" /></Button.ToolTip>
                    <Path Style="{StaticResource Style.Icon.Toolbar}" Data="{StaticResource Icon.Rotate}" />
                </Button>

                <Border Style="{StaticResource Style.ToolbarSeparator}" />

                <Button Style="{StaticResource Style.Button.Toolbar}" Command="{Binding BackCommand}" AutomationProperties.Name="{loc:Str Toolbar_Back}">
                    <Button.ToolTip><ToolTip Content="{Binding BackTip}" ContentTemplate="{StaticResource TipTemplate}" /></Button.ToolTip>
                    <Grid Width="40" Height="40">
                        <Path Style="{StaticResource Style.Icon.Toolbar}" Width="17" Height="17" Data="{StaticResource Icon.Back}" />
                        <Ellipse Style="{StaticResource Style.InjectionDot}" Visibility="{Binding InjectionBlocked, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource Style.Button.Toolbar}" Command="{Binding HomeCommand}" AutomationProperties.Name="{loc:Str Toolbar_Home}">
                    <Button.ToolTip><ToolTip Content="{Binding HomeTip}" ContentTemplate="{StaticResource TipTemplate}" /></Button.ToolTip>
                    <Grid Width="40" Height="40">
                        <Path Style="{StaticResource Style.Icon.Toolbar}" Width="17" Height="17" Data="{StaticResource Icon.HomeCircle}" />
                        <Ellipse Style="{StaticResource Style.InjectionDot}" Visibility="{Binding InjectionBlocked, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource Style.Button.Toolbar}" Command="{Binding RecentsCommand}" AutomationProperties.Name="{loc:Str Toolbar_Recents}">
                    <Button.ToolTip><ToolTip Content="{Binding RecentsTip}" ContentTemplate="{StaticResource TipTemplate}" /></Button.ToolTip>
                    <Grid Width="40" Height="40">
                        <Path Style="{StaticResource Style.Icon.Toolbar}" Width="17" Height="17" Data="{StaticResource Icon.Recents}" />
                        <Ellipse Style="{StaticResource Style.InjectionDot}" Visibility="{Binding InjectionBlocked, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource Style.Button.Toolbar}" Command="{Binding NotificationsCommand}" AutomationProperties.Name="{loc:Str Toolbar_Notifications}">
                    <Button.ToolTip><ToolTip Content="{Binding NotificationsTip}" ContentTemplate="{StaticResource TipTemplate}" /></Button.ToolTip>
                    <Path Style="{StaticResource Style.Icon.Toolbar}" Data="{StaticResource Icon.Bell}" />
                </Button>

                <Border Style="{StaticResource Style.ToolbarSeparator}" />

                <Button Style="{StaticResource Style.Button.Toolbar}" Command="{Binding ScreenshotCommand}" AutomationProperties.Name="{loc:Str Toolbar_Screenshot}">
                    <Button.ToolTip><ToolTip Content="{Binding ScreenshotTip}" ContentTemplate="{StaticResource TipTemplate}" /></Button.ToolTip>
                    <Path Style="{StaticResource Style.Icon.Toolbar}" Data="{StaticResource Icon.Camera}" />
                </Button>
                <Button Style="{StaticResource Style.Button.Toolbar}" Command="{Binding ToggleRecordingCommand}" AutomationProperties.Name="{loc:Str Toolbar_Record}">
                    <Button.ToolTip><ToolTip Content="{Binding RecordTip}" ContentTemplate="{StaticResource TipTemplate}" /></Button.ToolTip>
                    <Grid Width="40" Height="40">
                        <Path Style="{StaticResource Style.Icon.Record}" Data="{StaticResource Icon.RecordRing}" />
                        <Path Style="{StaticResource Style.Icon.RecordDot}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource Style.Button.Toolbar.Files}" Command="{Binding ToggleFilesCommand}" AutomationProperties.Name="{loc:Str Toolbar_Files}">
                    <Button.ToolTip><ToolTip Content="{Binding FilesTip}" ContentTemplate="{StaticResource TipTemplate}" /></Button.ToolTip>
                    <Path Style="{StaticResource Style.Icon.Toolbar}" Data="{StaticResource Icon.Folder}" />
                </Button>
                <Button Style="{StaticResource Style.Button.Toolbar}" Command="{Binding InstallApkCommand}" AutomationProperties.Name="{loc:Str Toolbar_InstallApk}">
                    <Button.ToolTip><ToolTip Content="{Binding InstallApkTip}" ContentTemplate="{StaticResource TipTemplate}" /></Button.ToolTip>
                    <Path Style="{StaticResource Style.Icon.Toolbar}" Data="{StaticResource Icon.Download}" />
                </Button>
                <Button Style="{StaticResource Style.Button.Toolbar}" Command="{Binding SendClipboardCommand}" AutomationProperties.Name="{loc:Str Toolbar_SendClipboard}">
                    <Button.ToolTip><ToolTip Content="{Binding SendClipboardTip}" ContentTemplate="{StaticResource TipTemplate}" /></Button.ToolTip>
                    <Grid Width="40" Height="40">
                        <Path Style="{StaticResource Style.Icon.Toolbar}" Data="{StaticResource Icon.Clipboard}" />
                        <Ellipse Style="{StaticResource Style.InjectionDot}" Visibility="{Binding InjectionBlocked, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Button>

                <Border Style="{StaticResource Style.ToolbarSeparator}" />

                <Button x:Name="MoreButton" Style="{StaticResource Style.Button.Toolbar}" Click="OnMoreClick" AutomationProperties.Name="{loc:Str Toolbar_More}">
                    <Button.ToolTip><ToolTip Content="{Binding MoreTip}" ContentTemplate="{StaticResource TipTemplate}" /></Button.ToolTip>
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource Style.ContextMenu}" Placement="Right" HorizontalOffset="8">
                            <MenuItem Style="{StaticResource Style.MenuItem}" Header="{loc:Str Toolbar_MenuShowTouches}" IsChecked="{Binding ShowTouches, Mode=OneWay}" Command="{Binding ToggleShowTouchesCommand}" />
                            <MenuItem Style="{StaticResource Style.MenuItem}" Header="{loc:Str Toolbar_MenuScreenOff}" Command="{Binding ScreenOffCommand}" />
                            <MenuItem Style="{StaticResource Style.MenuItem}" Header="{loc:Str Toolbar_MenuScreenOn}" Command="{Binding ScreenOnCommand}" />
                            <Separator Style="{StaticResource Style.MenuSeparator}" />
                            <MenuItem Style="{StaticResource Style.MenuItem}" Header="{loc:Str Toolbar_MenuOpenScreenshots}" Command="{Binding OpenScreenshotsFolderCommand}" />
                            <MenuItem Style="{StaticResource Style.MenuItem}" Header="{loc:Str Toolbar_MenuOpenRecordings}" Command="{Binding OpenRecordingsFolderCommand}" />
                            <MenuItem Style="{StaticResource Style.MenuItem}" Header="{loc:Str Toolbar_MenuCopyInfo}" Command="{Binding CopyDeviceInfoCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Path Style="{StaticResource Style.Icon.Toolbar}" Data="{StaticResource Icon.More}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="0" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Sisi: legenda titik kuning (atas) dan toast (bawah) -->
        <Grid x:Name="SidePanel" Grid.Column="1" Margin="8,0,0,0">
            <!-- Panel file browser (Fase 6); legenda dan toast menumpuk di atasnya -->
            <views:FilesPanel x:Name="FilesPanelView" DataContext="{Binding FilesPanel}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Visibility="{Binding DataContext.IsFilesOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
            <Thumb x:Name="ResizeThumb" Style="{StaticResource Style.ResizeThumb}" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,12"
                   Visibility="{Binding IsFilesOpen, Converter={StaticResource BoolToVis}}" ToolTip="{loc:Str Files_ResizeHint}"
                   DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted" AutomationProperties.Name="{loc:Str Files_ResizeHint}" />
            <Border Style="{StaticResource Style.ToolbarLegend}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="0,40,0,0"
                    Visibility="{Binding LegendVisible, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="{loc:Str Toolbar_Blocked}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ShowGuideCommand}" />
                </Border.InputBindings>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.WarningIcon}" VerticalAlignment="Top" Margin="0,5,8,0" />
                    <TextBlock Style="{StaticResource Style.Text}" FontSize="{StaticResource FontSize.Tiny}" Foreground="{StaticResource Brush.WarningBody}" Width="152" LineHeight="16" Text="{loc:Str Toolbar_Blocked}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Style.Toast}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Visibility="{Binding Toast, Converter={StaticResource NullToCollapsed}}"
                    AutomationProperties.Name="{Binding Toast.Title}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                            <Path Style="{StaticResource Style.Icon}" Width="15" Height="15" StrokeThickness="2.6" VerticalAlignment="Center" Margin="0,0,8,0" Data="{StaticResource Icon.Check}" Stroke="{StaticResource Brush.Accent}" Visibility="{Binding Toast.IsError, Converter={StaticResource InvertedBoolToVisibility}}" />
                            <Path Style="{StaticResource Style.Icon}" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0" Data="{StaticResource Icon.Warning}" Stroke="{StaticResource Brush.ErrorIcon}" Visibility="{Binding Toast.IsError, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Style="{StaticResource Style.Text}" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Toast.Title}" />
                        </StackPanel>
                        <Button Style="{StaticResource Style.Button.Subtle}" Width="22" Height="22" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding DismissToastCommand}" AutomationProperties.Name="{loc:Str Toast_Dismiss}" HorizontalContentAlignment="Center">
                            <TextBlock Text="×" FontSize="14" />
                        </Button>
                    </Grid>
                    <TextBlock Style="{StaticResource Style.Text.Muted}" FontSize="{StaticResource FontSize.Tiny}" LineHeight="15" Margin="0,6,0,0" Text="{Binding Toast.Body}" Visibility="{Binding Toast.Body, Converter={StaticResource NullToCollapsed}}" />
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <Button Style="{StaticResource Style.Button.Toast}" Margin="0,0,4,0" Command="{Binding ToastOpenCommand}" Content="{loc:Str Toast_Open}" Visibility="{Binding Toast.HasOpen, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource Style.Button.Toast}" Margin="4,0,0,0" Command="{Binding ToastFolderCommand}" Content="{loc:Str Toast_Folder}" Visibility="{Binding Toast.HasFolder, Converter={StaticResource BoolToVis}}" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
