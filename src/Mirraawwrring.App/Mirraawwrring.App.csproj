<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms hanya untuk NotifyIcon (ikon tray); WPF tidak menyediakannya. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFO0003: analyzer WinForms minta DPI diatur lewat API-nya; DPI aplikasi ini diatur WPF lewat app.manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>Mirraawwrring</AssemblyName>
    <RootNamespace>Mirraawwrring.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mirraawwrring.Core\Mirraawwrring.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms menambah global using System.Windows.Forms yang bentrok dengan tipe WPF (TextBox, DragEventArgs, …); hanya TrayIcon.cs yang meng-import-nya. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <!-- Manifest versi scrcpy ikut disalin ke samping exe agar bisa dibaca SetupService. -->
    <None Include="..\..\config\scrcpy-manifest.json" Link="config\scrcpy-manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
