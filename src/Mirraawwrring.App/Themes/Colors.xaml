<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Token warna dari mockup (PROMPT.md §7). Semua warna UI HARUS lewat sini,
        jangan tulis hex langsung di XAML view.
    -->

    <!-- Latar -->
    <Color x:Key="Color.WindowBackground">#17191E</Color>
    <Color x:Key="Color.TitleBar">#111317</Color>
    <Color x:Key="Color.Panel">#1F2228</Color>
    <Color x:Key="Color.Card">#262A31</Color>
    <Color x:Key="Color.CardHover">#2C3038</Color>
    <Color x:Key="Color.CardPressed">#2F333C</Color>
    <Color x:Key="Color.Disabled">#2F333C</Color>
    <Color x:Key="Color.Log">#0F1114</Color>
    <Color x:Key="Color.StatusBar">#1A1D22</Color>

    <!-- Border -->
    <Color x:Key="Color.Border">#2C3039</Color>
    <Color x:Key="Color.BorderStrong">#343944</Color>
    <Color x:Key="Color.BorderControl">#3A3F4A</Color>

    <!-- Teks -->
    <Color x:Key="Color.Text">#ECEEF1</Color>
    <Color x:Key="Color.TextSecondary">#C9CDD4</Color>
    <Color x:Key="Color.TextMuted">#A7ADB8</Color>
    <Color x:Key="Color.TextDisabled">#8A909C</Color>

    <!-- Aksen -->
    <Color x:Key="Color.Accent">#3DDC84</Color>
    <Color x:Key="Color.AccentHover">#57E396</Color>
    <Color x:Key="Color.AccentPressed">#2FC673</Color>
    <Color x:Key="Color.OnAccent">#0B1F13</Color>
    <Color x:Key="Color.AccentSoft">#1C2B22</Color>
    <Color x:Key="Color.AccentBadge">#23402E</Color>
    <Color x:Key="Color.AccentText">#8BEAB4</Color>
    <Color x:Key="Color.Link">#7FE3AB</Color>
    <Color x:Key="Color.LinkHover">#B4F0CD</Color>

    <!-- Peringatan -->
    <Color x:Key="Color.WarningIcon">#F2B84B</Color>
    <Color x:Key="Color.WarningText">#F5C870</Color>
    <Color x:Key="Color.WarningBody">#D9CBA8</Color>
    <Color x:Key="Color.WarningBackground">#2C2515</Color>
    <Color x:Key="Color.WarningBadge">#3B3018</Color>
    <Color x:Key="Color.WarningBorder">#6B5524</Color>

    <!-- Error -->
    <Color x:Key="Color.ErrorIcon">#FF9A8B</Color>
    <Color x:Key="Color.ErrorText">#FFB4A8</Color>
    <Color x:Key="Color.ErrorBody">#D8B9B3</Color>
    <Color x:Key="Color.ErrorButtonText">#FFD2CA</Color>
    <Color x:Key="Color.ErrorBackground">#2E1E1C</Color>
    <Color x:Key="Color.ErrorBorder">#6E3530</Color>

    <!-- Tooltip (terang di atas gelap) -->
    <Color x:Key="Color.TooltipBackground">#ECEEF1</Color>
    <Color x:Key="Color.TooltipText">#17191E</Color>
    <Color x:Key="Color.TooltipKeyBorder">#B8BDC6</Color>
    <Color x:Key="Color.TooltipKeyText">#3A3F4A</Color>

    <!-- Brush -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="{StaticResource Color.WindowBackground}" />
    <SolidColorBrush x:Key="Brush.TitleBar" Color="{StaticResource Color.TitleBar}" />
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}" />
    <SolidColorBrush x:Key="Brush.CardHover" Color="{StaticResource Color.CardHover}" />
    <SolidColorBrush x:Key="Brush.CardPressed" Color="{StaticResource Color.CardPressed}" />
    <SolidColorBrush x:Key="Brush.Disabled" Color="{StaticResource Color.Disabled}" />
    <SolidColorBrush x:Key="Brush.Log" Color="{StaticResource Color.Log}" />
    <SolidColorBrush x:Key="Brush.StatusBar" Color="{StaticResource Color.StatusBar}" />

    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.BorderControl" Color="{StaticResource Color.BorderControl}" />

    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.AccentBadge" Color="{StaticResource Color.AccentBadge}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.Link" Color="{StaticResource Color.Link}" />
    <SolidColorBrush x:Key="Brush.LinkHover" Color="{StaticResource Color.LinkHover}" />

    <SolidColorBrush x:Key="Brush.WarningIcon" Color="{StaticResource Color.WarningIcon}" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="{StaticResource Color.WarningText}" />
    <SolidColorBrush x:Key="Brush.WarningBody" Color="{StaticResource Color.WarningBody}" />
    <SolidColorBrush x:Key="Brush.WarningBackground" Color="{StaticResource Color.WarningBackground}" />
    <SolidColorBrush x:Key="Brush.WarningBadge" Color="{StaticResource Color.WarningBadge}" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="{StaticResource Color.WarningBorder}" />

    <SolidColorBrush x:Key="Brush.ErrorIcon" Color="{StaticResource Color.ErrorIcon}" />
    <SolidColorBrush x:Key="Brush.ErrorText" Color="{StaticResource Color.ErrorText}" />
    <SolidColorBrush x:Key="Brush.ErrorBody" Color="{StaticResource Color.ErrorBody}" />
    <SolidColorBrush x:Key="Brush.ErrorButtonText" Color="{StaticResource Color.ErrorButtonText}" />
    <SolidColorBrush x:Key="Brush.ErrorBackground" Color="{StaticResource Color.ErrorBackground}" />
    <SolidColorBrush x:Key="Brush.ErrorBorder" Color="{StaticResource Color.ErrorBorder}" />

    <SolidColorBrush x:Key="Brush.TooltipBackground" Color="{StaticResource Color.TooltipBackground}" />
    <SolidColorBrush x:Key="Brush.TooltipText" Color="{StaticResource Color.TooltipText}" />
    <SolidColorBrush x:Key="Brush.TooltipKeyBorder" Color="{StaticResource Color.TooltipKeyBorder}" />
    <SolidColorBrush x:Key="Brush.TooltipKeyText" Color="{StaticResource Color.TooltipKeyText}" />

    <!-- Tipografi -->
    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Small">12</sys:Double>
    <sys:Double x:Key="FontSize.Tiny">11</sys:Double>
    <sys:Double x:Key="FontSize.Emphasis">14</sys:Double>
    <sys:Double x:Key="FontSize.Heading">15</sys:Double>
    <sys:Double x:Key="FontSize.Title">18</sys:Double>
    <sys:Double x:Key="FontSize.Log">11.5</sys:Double>

    <!-- Radius -->
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">10</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

</ResourceDictionary>
