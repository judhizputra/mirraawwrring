<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Ikon garis (viewBox 24x24, stroke 2) diambil dari SVG mockup. Pakai dengan Style.Icon:
        <Path Style="{StaticResource Style.Icon}" Data="{StaticResource Icon.Phone}" Stroke="{StaticResource Brush.Accent}" />
    -->

    <Geometry x:Key="Icon.Phone">M8,2 H16 A2,2 0 0 1 18,4 V20 A2,2 0 0 1 16,22 H8 A2,2 0 0 1 6,20 V4 A2,2 0 0 1 8,2 Z M11,18 H13</Geometry>
    <Geometry x:Key="Icon.Refresh">M21,12 A9,9 0 1 1 18.4,5.6 M21,3 V9 H15</Geometry>
    <Geometry x:Key="Icon.Wifi">M5,12.5 A10,10 0 0 1 19,12.5 M8.5,16 A5,5 0 0 1 15.5,16 M12,19.5 H12.01</Geometry>
    <Geometry x:Key="Icon.Link">M10,13 A5,5 0 0 0 17.5,13.5 L20.5,10.5 A5,5 0 0 0 13.5,3.5 L11.8,5.2 M14,11 A5,5 0 0 0 6.5,10.5 L3.5,13.5 A5,5 0 0 0 10.5,20.5 L12.2,18.8</Geometry>
    <Geometry x:Key="Icon.Warning">M10.3,3.9 L1.8,18 A2,2 0 0 0 3.5,21 H20.5 A2,2 0 0 0 22.2,18 L13.7,3.9 A2,2 0 0 0 10.3,3.9 Z M12,9 V13 M12,17 H12.01</Geometry>
    <Geometry x:Key="Icon.Cursor">M4,4 L11,20 L13.5,13.5 L20,11 Z</Geometry>
    <Geometry x:Key="Icon.Eye">M2,12 C2,12 5.6,5 12,5 C18.4,5 22,12 22,12 C22,12 18.4,19 12,19 C5.6,19 2,12 2,12 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12</Geometry>
    <Geometry x:Key="Icon.Moon">M21,12.8 A9,9 0 1 1 11.2,3 A7,7 0 0 0 21,12.8 Z</Geometry>
    <Geometry x:Key="Icon.Bolt">M13,2 L3,14 H12 L11,22 L21,10 H12 L13,2 Z</Geometry>
    <Geometry x:Key="Icon.Check">M20,6 L9,17 L4,12</Geometry>
    <Geometry x:Key="Icon.Info">M12,22 A10,10 0 1 1 12,2 A10,10 0 1 1 12,22 Z M12,16 V12 M12,8 H12.01</Geometry>
    <Geometry x:Key="Icon.Usb">M12,2 V22 M12,22 L8,18 M12,22 L16,18 M12,8 L17,11 V14 M12,11 L7,13 V17 M17,11 A1.5,1.5 0 1 0 17,8 A1.5,1.5 0 1 0 17,11 Z</Geometry>
    <Geometry x:Key="Icon.Monitor">M4,4 H16 A2,2 0 0 1 18,6 V12 A2,2 0 0 1 16,14 H4 A2,2 0 0 1 2,12 V6 A2,2 0 0 1 4,4 Z M15,9 H22 V21 H15 Z M7,18 H11</Geometry>

    <!-- Terisi (fill), tanpa stroke -->
    <Geometry x:Key="Icon.Play">M6,4 L20,12 L6,20 Z</Geometry>

    <Style x:Key="Style.Icon" TargetType="Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Stroke" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
    </Style>

</ResourceDictionary>
