<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Mirraawwrring.Core: logika aplikasi TANPA referensi WPF.
    Berisi IProcessRunner, ToolLocator, AdbClient, parser, ScrcpyArgumentBuilder, dll.
    Target net10.0-windows karena memakai API khusus Windows (symlink winget, nanti WMI),
    tetapi tidak boleh mereferensikan PresentationFramework/WPF.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Mirraawwrring.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mirraawwrring.Core.Tests" />
  </ItemGroup>

</Project>
